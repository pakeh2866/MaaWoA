{
    "option": {
        "mailNotify": {
            "type": "switch",
            //任务异常时发送邮件提醒的总开关
            "label": "$pi.task.option.mailNotify.name",
            "description": "$pi.task.option.mailNotify.description",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "option": [
                        "mailNotifyConfig"
                    ],
                    "pipeline_override": {
                        "notifyMailOnFailure": {
                            //主要更改enabled
                            "enabled": true
                        }
                    }
                }
            ],
            "default_case": "No"
        },
        "mailNotifyConfig": {
            //仅在上层 mailNotify 选择 Yes 时激活
            "type": "input",
            "label": "$pi.task.option.mailNotifyConfig.name",
            "description": "$pi.task.option.mailNotifyConfig.description",
            "inputs": [
                {
                    "name": "smtp_host",
                    "label": "$pi.task.option.mailNotifyConfig.smtpHost.label",
                    "default": "smtp.qq.com"
                },
                {
                    "name": "smtp_port",
                    "label": "$pi.task.option.mailNotifyConfig.smtpPort.label",
                    "default": "587",
                    "pipeline_type": "int",
                    "verify": "^\\d{2,5}$",
                    "pattern_msg": "$pi.task.option.mailNotifyConfig.smtpPort.patternMsg"
                },
                {
                    "name": "smtp_user",
                    "label": "$pi.task.option.mailNotifyConfig.smtpUser.label",
                    "verify": "^[^@\\s]+@[^@\\s]+$",
                    "pattern_msg": "$pi.task.option.mailNotifyConfig.email.patternMsg"
                },
                {
                    "name": "smtp_password",
                    "label": "$pi.task.option.mailNotifyConfig.smtpPassword.label",
                    "password": true
                },
                {
                    "name": "mail_to",
                    "label": "$pi.task.option.mailNotifyConfig.mailTo.label",
                    "verify": "^[^@\\s]+@[^@\\s]+$",
                    "pattern_msg": "$pi.task.option.mailNotifyConfig.email.patternMsg"
                },
                {
                    "name": "mail_subject",
                    "label": "$pi.task.option.mailNotifyConfig.mailSubject.label",
                    "default": "MaaWoA 无人值守中断"
                },
                {
                    "name": "min_interval",
                    "label": "$pi.task.option.mailNotifyConfig.minInterval.label",
                    "default": "10",
                    "pipeline_type": "int",
                    "verify": "^\\d{1,3}$",
                    "pattern_msg": "$pi.task.option.mailNotifyConfig.minInterval.patternMsg"
                }
            ],
            "pipeline_override": {
                "notifyMailOnFailure": {
                    "custom_action_param": {
                        "host": "{smtp_host}",
                        "port": "{smtp_port}",
                        "user": "{smtp_user}",
                        "password": "{smtp_password}",
                        "to": "{mail_to}",
                        "subject": "{mail_subject}",
                        "min_interval": "{min_interval}"
                    }
                }
            }
        }
    }
}
