{
    "checkAll": {
        "action": "Screencap",
        "next": [
            "notifyMailOnFailure",
            "checkUpgradeCard",
            "checkBack",
            "restartApp"
        ],
        "focus": {
            "Node.NextList.Starting": {
                "content": "$pipeline.checkAll.focus.Node.NextList.Starting",
                "display": [
                    "log",
                    "toast",
                    "notification"
                ]
            }
        }
    },
    "notifyMailOnFailure": {
        //页面识别失败进入故障恢复时的邮件提醒，enabled 由 base 选项 mailNotify 覆写
        //未在设置里配置完整的 SMTP 参数时，action 直接跳过，不影响恢复流程
        "enabled": false,
        "action": {
            "type": "Custom",
            "param": {
                "custom_action": "notify_mail",
                "custom_action_param": {
                    "host": "",
                    "port": 587,
                    "user": "",
                    "password": "",
                    "to": "",
                    "subject": "MaaWoA 无人值守中断",
                    "min_interval": 10
                }
            }
        },
        "next": [
            "checkUpgradeCard",
            "checkBack",
            "restartApp"
        ],
        "focus": {
            "Node.Action.Succeeded": "$pipeline.notifyMailOnFailure.focus.Node.Action.Succeeded"
        }
    },
    "checkBack": {
        "recognition": {
            "type": "NeuralNetworkDetect",
            "param": {
                "expected": "back",
                "model": "MaaWoA-widget.onnx"
            }
        },
        "action": "Click",
        "target_offset": [
            20,
            20,
            -40,
            -40
        ],
        "post_wait_freezes": 200,
        "next": [
            "detectPage"
        ]
    },
    "checkUpgradeCard": {
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    {
                        "recognition": {
                            "type": "NeuralNetworkDetect",
                            "param": {
                                "expected": "contractUpgradeCard",
                                "model": "MaaWoA-card.onnx"
                            }
                        }
                    },
                    "__cmatchYellowButtonNoROI__"
                ],
                "box_index": 1
            }
        },
        "action": "Click",
        "post_wait_freezes": 200,
        "next": [
            "detectPage"
        ]
    }
}
